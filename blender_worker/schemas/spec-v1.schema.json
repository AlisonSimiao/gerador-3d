{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gerador-3d.local/schemas/spec-v1.schema.json",
  "title": "Gerador 3D Spec v1",
  "oneOf": [
    {
      "$ref": "#/$defs/house"
    },
    {
      "$ref": "#/$defs/sword"
    },
    {
      "$ref": "#/$defs/tree"
    },
    {
      "$ref": "#/$defs/chest"
    }
  ],
  "$defs": {
    "house": {
      "title": "HouseSpec",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "house"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "width": {
          "type": "number",
          "minimum": 3,
          "maximum": 12,
          "default": 6.0
        },
        "depth": {
          "type": "number",
          "minimum": 3,
          "maximum": 10,
          "default": 5.0
        },
        "floors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 1
        },
        "roof_form": {
          "type": "string",
          "enum": [
            "gable",
            "hip"
          ],
          "default": "gable"
        },
        "wall_finish": {
          "type": "string",
          "enum": [
            "plaster",
            "timber",
            "stone"
          ],
          "default": "plaster"
        },
        "window_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 4
        },
        "has_chimney": {
          "type": "boolean",
          "default": true
        },
        "style": {
          "type": "string",
          "const": "medieval_lowpoly",
          "default": "medieval_lowpoly"
        }
      },
      "required": [
        "spec_version",
        "type",
        "seed"
      ]
    },
    "sword": {
      "title": "SwordSpec",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "sword"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "blade_length": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.1,
          "default": 0.9
        },
        "blade_width": {
          "type": "number",
          "minimum": 0.04,
          "maximum": 0.1,
          "default": 0.07
        },
        "guard_form": {
          "type": "string",
          "enum": [
            "straight",
            "curved",
            "none"
          ],
          "default": "straight"
        },
        "grip_length": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.18,
          "default": 0.14
        },
        "pommel_form": {
          "type": "string",
          "enum": [
            "round",
            "faceted",
            "none"
          ],
          "default": "round"
        },
        "style": {
          "type": "string",
          "const": "medieval_lowpoly",
          "default": "medieval_lowpoly"
        }
      },
      "required": [
        "spec_version",
        "type",
        "seed"
      ]
    },
    "tree": {
      "title": "TreeSpec",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "tree"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "trunk_height": {
          "type": "number",
          "minimum": 1.5,
          "maximum": 8,
          "default": 3.0
        },
        "trunk_radius": {
          "type": "number",
          "minimum": 0.12,
          "maximum": 0.6,
          "default": 0.25
        },
        "canopy_form": {
          "type": "string",
          "enum": [
            "clustered",
            "round",
            "conical"
          ],
          "default": "clustered"
        },
        "foliage_palette": {
          "type": "string",
          "enum": [
            "green",
            "autumn",
            "dark_green"
          ],
          "default": "green"
        },
        "lean_degrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "default": 5.0
        },
        "style": {
          "type": "string",
          "const": "medieval_lowpoly",
          "default": "medieval_lowpoly"
        }
      },
      "required": [
        "spec_version",
        "type",
        "seed"
      ]
    },
    "chest": {
      "title": "ChestSpec",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "chest"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "width": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.8,
          "default": 1.0
        },
        "height": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1.1,
          "default": 0.6
        },
        "depth": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1,
          "default": 0.6
        },
        "lid_form": {
          "type": "string",
          "enum": [
            "arched",
            "flat"
          ],
          "default": "arched"
        },
        "band_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "default": 2
        },
        "has_lock": {
          "type": "boolean",
          "default": true
        },
        "style": {
          "type": "string",
          "const": "medieval_lowpoly",
          "default": "medieval_lowpoly"
        }
      },
      "required": [
        "spec_version",
        "type",
        "seed"
      ]
    }
  }
}
